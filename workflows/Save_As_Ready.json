      "parameters": {
        "jsCode": "const active = ($json.values && $json.values[0]) || [];\nif (!active[0] || !active[1]) return []; // tidak ada file aktif, jangan buat Ready\n\nconst rows = $('Get Pending Cutoffs').first().json.values || [];\nreturn rows\n  .slice(1) // lewati header\n  .filter(row => row[1] === 'pending' && row[0] === active[0]) // hanya tanggal yang sedang aktif\n  .map((row, i) => ({ json: { attachmentName: row[0], rowNumber: i + 2 } }));"
      },
