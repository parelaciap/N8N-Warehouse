    {
      "parameters": {
        "jsCode": "const emails = $input.all();\nconst currentAttachmentName = $('Loop Pending Cutoffs').first().json.attachmentName;\n\nconst withNames = emails\n  .map(e => ({\n    item: e,\n    fileName: e.binary?.attachment_0?.fileName?.replace('.zip', '') || null,\n    date: new Date(e.json.date).getTime(), // diperbaiki dari e.json.internalDate\n  }))\n  .filter(e => e.fileName !== null)\n  .sort((a, b) => a.date - b.date);\n\nconst idx = withNames.findIndex(e => e.fileName === currentAttachmentName);\nif (idx === -1 || idx === withNames.length - 1) {\n  return []; // email berikutnya belum ada, coba lagi 30 menit lagi\n}\n\nreturn [{ json: { attachmentName: currentAttachmentName, nextAttachmentName: withNames[idx + 1].fileName } }];"
      },
