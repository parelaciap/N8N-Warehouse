      "parameters": {
        "jsCode": "const items = $input.all();\nconst rows = items.map(item => item.json.row);\n\nconst dataRows = rows.slice(3);\n\nconst seenSKUs = new Set();\nconst newMasterRows = [];\nfor (const row of dataRows) {\n  const sku = row[0];\n  if (sku === undefined || sku === null || String(sku).trim() === '') continue;\n  const skuKey = String(sku).trim();\n\n  if (!/^\\d{8}$/.test(skuKey)) continue;\n  if (seenSKUs.has(skuKey)) continue;\n  seenSKUs.add(skuKey);\n\n  const desc = row[1];\n  const pcCs = row[3];\n  const barcode = row[5];      // F: barcode product\n  const outerBarcode = row[6]; // G: barcode dus/outer\n\n  newMasterRows.push({\n    sku: skuKey,\n    values: [sku, desc, pcCs, barcode, outerBarcode],\n  });\n}\n\nreturn [{ json: { newMasterRows } }];"
      },
